# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o Git.

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SECRETA: acesso total ao banco. Somente no servidor (".env" local e variáveis do Render).
# Nunca no front-end, nunca no código, nunca no Git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documentos

# --- Parâmetros do sistema (opcionais; estes são os valores padrão) ---
MAX_FILE_MB=10          # limite por arquivo
QUOTA_MB=900            # cota total de armazenamento (ativos + lixeira)
TRASH_DAYS=30           # dias até a limpeza automática da lixeira
PENDING_TTL_MIN=60      # pendentes mais antigos que isso são descartados
SIGNED_URL_TTL_S=300    # validade dos links temporários, em segundos
